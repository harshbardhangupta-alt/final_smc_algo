# =============================================================================
# AI-POWERED NSE STOCK SELECTION & AUTOMATED TRADING SYSTEM
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# -- Application --------------------------------------------------------------
APP_ENV=development
# Secret used to sign session cookies / tokens for the backend control panel.
# Generate a strong random value, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO

# -- Database -----------------------------------------------------------------
# Local development (default): SQLite file.
DATABASE_URL=sqlite:///./data/app.db
# Production example (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/smc_trading

# -- Backend admin credentials (control panel / settings / auto-trading) ------
# The first run seeds this admin user. Change the password immediately.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# -- Dhan broker / market-data API --------------------------------------------
# Obtain from https://dhanhq.co/ (Dhan -> DhanHQ Trading APIs).
# Leave blank to run in OFFLINE mode (no live data, no orders).
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# Base URL for DhanHQ v2 REST API. Verify against current official docs.
DHAN_API_BASE=https://api.dhan.co/v2
# Requests per second cap applied by the client-side rate limiter.
DHAN_RATE_LIMIT_RPS=5

# -- OpenAI API (news + fundamental interpretation) ---------------------------
# Obtain from https://platform.openai.com/. Leave blank to disable AI research
# (the system then applies the configured fail-closed policy to new trades).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=40

# -- News provider (optional licensed news API) -------------------------------
# Example: NewsAPI.org style key. Leave blank to rely only on exchange
# disclosures / configured sources. Respect each provider's terms & licensing.
NEWS_API_KEY=
NEWS_API_BASE=https://newsapi.org/v2

# -- Scanning / scheduling ----------------------------------------------------
# Master switch for the background scanner (true/false).
SCHEDULER_ENABLED=true
# Full-universe scan interval in minutes during market hours.
SCAN_INTERVAL_MINUTES=30
